APP_URL=http://127.0.0.1:5500
SESSION_SECRET=change-me-to-a-long-random-string

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized JavaScript origin: http://127.0.0.1:5500
# Authorized redirect URI:     http://127.0.0.1:5500/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Developers → App → Facebook Login → Settings
# Valid OAuth Redirect URI: http://127.0.0.1:5500/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Telegram BotFather: create a bot, then /setdomain (a real domain; 127.0.0.1 often rejected)
# TELEGRAM_BOT_TOKEN looks like 123456789:AAH...
# TELEGRAM_BOT_USERNAME is the bot username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Production (Netlify → Environment variables, then redeploy):
# APP_URL=https://bizgarh.com
# TELEGRAM_BOT_TOKEN=<same BotFather token>
# BotFather /setdomain = bizgarh.com (no https)
