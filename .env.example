APP_URL=http://127.0.0.1:5500
SESSION_SECRET=change-me-to-a-long-random-string

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized JavaScript origin: http://127.0.0.1:5500
# Authorized redirect URI:     http://127.0.0.1:5500/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Developers → App → Facebook Login → Settings
# Valid OAuth Redirect URI: http://127.0.0.1:5500/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Telegram BotFather: create a bot, then /setdomain (a real domain; 127.0.0.1 often rejected)
# TELEGRAM_BOT_TOKEN looks like 123456789:AAH...
# TELEGRAM_BOT_USERNAME is the bot username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Welcome mail after a course buy (GoDaddy mailbox)
# Cloudflare Pages → Settings → Environment variables, then redeploy:
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=desk@bizgarh.com
# SMTP_PASS=<desk mailbox password>
# MAIL_FROM=Bizgarh Desk <desk@bizgarh.com>
# Creator day-close mail: earning = superadmin share % (or fixed ₹) × each sale.
# Bind Cloudflare KV namespace SALES on the Pages project. Midnight IST flushes yesterday.
# If the mailbox is Microsoft 365 instead:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# APP_URL=https://bizgarh.com
# TELEGRAM_BOT_TOKEN=<same BotFather token>
# BotFather /setdomain = bizgarh.com (no https)
# VdoCipher DRM (recorded classroom player)
# Dashboard → Config → API Keys. Never put this in frontend JS.
# Cloudflare Pages → Settings → Environment variables, then redeploy:
# VDOCIPHER_API_SECRET=
# That key must allow Uploader (VdoCipher → Config → API Keys → edit key / Full Access).
# After changing the secret on Cloudflare Pages, redeploy.
# Or upload on VdoCipher dashboard and paste the video ID on the lesson form.

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from Google Cloud Web OAuth client
# Authorized JavaScript origins:
#   https://bizgarh.com
#   https://www.bizgarh.com
# Authorized redirect URIs:
#   https://bizgarh.com/auth/google/callback
#   https://www.bizgarh.com/auth/google/callback
